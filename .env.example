# Copy this file to .env and fill in the values you have. Each one is
# optional - the Social tab works with whichever sources are configured and
# silently skips the rest.

# Reddit (for r/IndianStreetBets etc.): as of Reddit's Nov 2025 Responsible
# Builder Policy, https://www.reddit.com/prefs/apps no longer issues new
# credentials to personal/hobby projects - it redirects straight to the
# policy page instead of the old "create app" form. If you already have
# credentials from before Nov 2025 they still work here; otherwise leave
# this blank and rely on YOUTUBE_API_KEY below, which has no such gate.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=indian-stock-app/0.1 (personal use)

# YouTube (for comments on CNBC-TV18/Moneycontrol/finance-YouTuber videos):
# create a project at https://console.cloud.google.com, enable "YouTube Data
# API v3", then create an API key under Credentials. No approval wait.
YOUTUBE_API_KEY=

# Discord (for chatter in a trading server's channels): free, no approval
# needed under Discord's 10,000-user privileged-intent threshold, but it
# only does anything for servers your bot has actually been added to -
# there's no default here since we can't add a bot to a community we don't
# own for you.
#   1. https://discord.com/developers/applications -> New Application
#   2. Left sidebar -> Bot -> Reset Token, copy it into DISCORD_BOT_TOKEN
#   3. Same Bot page -> scroll to "Message Content Intent" -> toggle it on -> Save
#   4. Left sidebar -> OAuth2 -> URL Generator -> scopes: "bot" ->
#      permissions: "Read Message History", "View Channel" -> open the
#      generated URL and add the bot to a server you own or admin
#   5. In Discord, right-click the channel(s) you want -> Copy Channel ID
#      (enable Settings -> Advanced -> Developer Mode first if you don't see
#      this option) -> put them here, comma-separated
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_IDS=

# Telegram needs no setup - it reads CNBC-TV18's and Moneycontrol's public
# channel previews directly, no key required. Nothing to configure here.

# Company logos in the stock lists (real brand marks instead of the colored
# initials fallback): sign up free at https://logo.dev (500k requests/month
# free), grab your publishable key. Clearbit's old free logo API, which this
# used to use, was shut down Dec 1, 2025.
LOGO_DEV_API_KEY=

# Signs login session tokens. Without this set, the backend generates a
# random one at every startup, which means everyone gets logged out each
# time you restart the server - set a fixed value (any long random string)
# once you want sessions to survive restarts. Required in production
# (Render restarts the server on every deploy and after idle spin-down, so
# without this every restart would log everyone out).
JWT_SECRET=

# User accounts/watchlist database. Leave blank for local dev (falls back
# to a SQLite file at backend/app/data/app.db). In production on Render,
# set this to a Postgres connection string - Render's free web services
# have an ephemeral filesystem, so a local SQLite file there gets wiped on
# every restart/spin-down. Neon (https://neon.tech) has a free Postgres
# tier with no time-based expiration that works well for this: create a
# project, copy its connection string here. Paste it directly into
# Render's environment variable UI, not into chat/version control - it's a
# real credential.
DATABASE_URL=
